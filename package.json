{
  "name": "territory-wars",
  "version": "1.0.0",
  "description": "Browser-based 2D real-time territory conquest strategy game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "~5.3.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
