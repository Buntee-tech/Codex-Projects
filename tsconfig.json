{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Paths */
    "paths": {
      "@core/*": ["./core/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["client/**/*.ts", "core/**/*.ts", "server/**/*.ts", "shared/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vite.config.ts"]
}
